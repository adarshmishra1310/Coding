   "source": [
    "def gcd(a,b):\n",
    "    if(a==0):\n",
    "        return b\n",
    "    if(a<b):\n",
    "        a,b = b,a\n",
    "    return gcd(a-b,b)\n",
    "\n",
    "a = int(input(\"Enter a:\"))\n",
    "b = int(input(\"Enter b:\"))\n",
    "print(gcd(a,b))"
   ]
